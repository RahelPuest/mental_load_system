# ── Basis ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=thealotta-api

# ── Datenbank ─────────────────────────────────────────────────────────
# Die Anwendung verbindet als NICHT-Superuser und NICHT-Tabelleneigentümer.
# Andernfalls umgeht Postgres die Row Level Security und die Tenant-Isolation ist wirkungslos.
# Die Rollen heißen `thealotta_*` – umbenannt in Migration 0012 (siehe docs/79).
DATABASE_URL=postgres://thealotta_app_user:thealotta_dev_only@localhost:55432/thealotta
# Nur für Migrationen und Wartung (Superuser).
DATABASE_ADMIN_URL=postgres://thealotta:thealotta_dev_only@localhost:55432/thealotta
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:56379

# ── Verschlüsselung ───────────────────────────────────────────────────
# 32 Byte je Schlüssel, base64. Erzeugen: openssl rand -base64 32
# Alte Schlüssel bleiben zum Entschlüsseln stehen (Rotation ohne Ausfall).
ENCRYPTION_KEYS={"k1":"ZGV2ZWxvcG1lbnRfb25seV9rZXlfMzJfYnl0ZXNfISE="}
ENCRYPTION_ACTIVE_KEY_ID=k1

# ── API ───────────────────────────────────────────────────────────────
# Port der API. 3000 ist auf vielen Rechnern schon belegt (z. B. durch Obsidian);
# in dem Fall hier und in VITE_API_URL denselben abweichenden Port eintragen.
PORT=3000
HOST=0.0.0.0
# Kommagetrennt; der erste Wert signiert, alle werden akzeptiert (Rotation).
SESSION_SECRETS=bitte_ersetzen_mindestens_32_zeichen_lang_1234
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Ziel des Entwicklungs-Proxys der Weboberfläche – muss zu PORT passen.
VITE_API_URL=http://127.0.0.1:3000

# ── Worker ────────────────────────────────────────────────────────────
WORKER_QUEUES=default,sync,notify
WORKER_CONCURRENCY=5
# Erzeugen: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.invalid
SMTP_URL=smtp://localhost:51025
SMTP_FROM=Thealotta <noreply@example.invalid>
FEATURE_GOOGLE_CALENDAR=false

# ── Tests ─────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgres://thealotta_app_user:thealotta_dev_only@localhost:55432/thealotta
