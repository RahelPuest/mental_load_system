# Vorlage für ops/docker/.env.prod – die echte Datei gehört NICHT ins Repository.
#
#   cp ops/docker/env.prod.example ops/docker/.env.prod
#   chmod 600 ops/docker/.env.prod
#   ops/scripts/thealotta secrets        # füllt alle Geheimnisse unten mit Zufallswerten
#
# Jede Variable ohne Wert lässt den Stack beim Start absichtlich scheitern – das Zod-Schema
# in packages/contracts/src/env.ts prüft zusätzlich beim Prozessstart.

# ── Wo liegt was ──────────────────────────────────────────────────────
# Datenbank und Redis: lokale SSD/NVMe des Pi. Niemals ein Netzlaufwerk.
DATA_DIR=/srv/thealotta
# Sicherungen: der NFS-Mount der Synology.
BACKUP_DIR=/mnt/synology/thealotta
TZ=Europe/Berlin

# ── Öffentliche Adresse ───────────────────────────────────────────────
# Muss https sein und exakt der Adresse entsprechen, die im Cloudflare-Tunnel steht.
PUBLIC_BASE_URL=https://thealotta.app

# ── Cloudflare Tunnel ─────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → Create tunnel → Docker → der Wert hinter --token
CF_TUNNEL_TOKEN=

# ── Datenbank ─────────────────────────────────────────────────────────
# Nur Buchstaben und Ziffern verwenden: die Werte landen in einer URL, Sonderzeichen
# müssten prozentkodiert werden. `ops/scripts/thealotta secrets` erzeugt sie passend.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
MONITOR_DB_PASSWORD=
NOTIFIER_DB_PASSWORD=
SYNC_DB_PASSWORD=
REDIS_PASSWORD=
DATABASE_POOL_MAX=10

# ── Geheimnisse der Anwendung ─────────────────────────────────────────
# Mindestens 32 Zeichen. Kommagetrennt für überlappende Rotation: der erste Wert signiert,
# alle werden zum Prüfen akzeptiert.
SESSION_SECRETS=
SESSION_TTL_DAYS=30

# DIES IST DER WICHTIGSTE WERT IM GANZEN AUFBAU.
# Geht er verloren, sind alle verschlüsselten Felder unwiederbringlich weg – kein Backup
# hilft, weil die Sicherung die Chiffrate enthält, nicht den Schlüssel.
# Gehört in den Passwortmanager UND auf Papier, nicht nur in diese Datei.
# Alte Schlüssel bleiben stehen, damit Rotation ohne Ausfall möglich ist (docs/27 §7).
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# ── Sicherung ─────────────────────────────────────────────────────────
# Verschlüsselt die Dumps, bevor sie das NAS erreichen. Ebenfalls in den Passwortmanager.
BACKUP_PASSPHRASE=
BACKUP_AT=02:30
KEEP_DAILY_DAYS=35
KEEP_MONTHLY_COUNT=12
# 1 = Montag … 7 = Sonntag. An diesem Tag wird die jüngste Sicherung testweise
# zurückgespielt und geprüft – ein Backup ohne getesteten Restore zählt nicht (docs/29 §5).
VERIFY_WEEKDAY=7
# Optional: eine Ping-URL (z. B. healthchecks.io, kostenlos), die anschlägt, wenn
# die nächtliche Sicherung ausbleibt. Ohne so etwas merkt man ein stilles Backup-Ende nie.
HEALTHCHECK_URL=

# ── Benachrichtigungen ────────────────────────────────────────────────
# Web Push braucht keinen Dienstleister und kostet nichts – erzeugen mit
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Eine Adresse, über die ein Push-Dienst dich im Störungsfall erreichen kann.
VAPID_SUBJECT=mailto:admin@thealotta.app

# E-Mail ist optional; ohne SMTP_URL bleiben Benachrichtigungen in der App.
# Für echte Zustellung ein kostenloses Relay eintragen, z. B.
#   SMTP_URL=smtp://benutzer:passwort@smtp-relay.brevo.com:587
SMTP_URL=
SMTP_FROM=Thealotta <noreply@thealotta.app>

FEATURE_GOOGLE_CALENDAR=false

# ── Betrieb ───────────────────────────────────────────────────────────
LOG_LEVEL=info
WORKER_CONCURRENCY=3
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10

# Wird von `ops/scripts/thealotta update` gepflegt – nicht von Hand ändern.
# Rollback heißt: hier den vorherigen Wert eintragen (oder `thealotta rollback` benutzen).
IMAGE_TAG=local
